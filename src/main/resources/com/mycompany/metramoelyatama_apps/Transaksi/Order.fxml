<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="844.0" prefWidth="1385.0"
            stylesheets="@../css/Dashboard.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.OrderController">

    <AnchorPane fx:id="masterOrder" layoutX="10.0" layoutY="10.0"
                prefHeight="872.0" prefWidth="1385.0"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>

            <AnchorPane layoutX="14.0" layoutY="7.0" prefHeight="820.0" prefWidth="434.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <Label layoutX="49.0" layoutY="17.0" styleClass="brand-title"
                           text="Input Data Order" textFill="#5f5157" />
                    <FontIcon iconLiteral="fas-user-plus" iconSize="20"
                              layoutX="14.0" layoutY="37.0" />

                    <VBox layoutX="9.0" layoutY="60.0" prefHeight="290.0" prefWidth="420.0" spacing="7.0">
                        <padding><Insets left="10.0" right="10.0" /></padding>
                        <children>
                            <Label styleClass="field-label" text="Client" />
                            <ComboBox fx:id="cmbclOrder" prefHeight="26.0" prefWidth="408.0"
                                      promptText="Pilih Client" styleClass="input-field" />

                            <Label styleClass="field-label" text="Karyawan" />
                            <ComboBox fx:id="cmbkrOrder" prefHeight="26.0" prefWidth="408.0"
                                      promptText="Pilih Karyawan" styleClass="input-field" />

                            <Label styleClass="field-label" text="Keterangan" />
                            <TextArea fx:id="txtketOrder" prefHeight="87.0" prefWidth="410.0"
                                      promptText="Catatan tambahan order..." styleClass="input-area" />

                            <Label styleClass="field-label" text="Status Order" />
                            <ComboBox fx:id="cmbstatusOrder" prefHeight="26.0" prefWidth="408.0"
                                      styleClass="input-field" />
                        </children>
                    </VBox>

                    <HBox layoutX="23.0" layoutY="431.0" spacing="50.0">
                        <children>
                            <VBox prefWidth="170.0" spacing="7.0">
                                <children>
                                    <Label styleClass="field-label" text="Tgl Order" />
                                    <DatePicker fx:id="txttglOrder" prefHeight="26.0" prefWidth="161.0"
                                                styleClass="date-picker-field" />
                                </children>
                            </VBox>
                            <VBox prefWidth="170.0" spacing="7.0">
                                <children>
                                    <Label styleClass="field-label" text="Batas Waktu" />
                                    <DatePicker fx:id="txtbwOrder" prefHeight="26.0" prefWidth="161.0"
                                                styleClass="date-picker-field" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox layoutX="8.0" layoutY="755.0" prefHeight="32.0" prefWidth="418.0" spacing="3.0">
                        <children>
                            <Button fx:id="btnsaveOrder" onAction="#btnsaveOrder"
                                    mnemonicParsing="false" styleClass="btn-primary"
                                    prefHeight="38.0" prefWidth="110.0" text="Simpan">
                                <graphic>
                                    <FontIcon iconColor="WHITE" iconLiteral="fas-save" iconSize="16" />
                                </graphic>
                            </Button>
                            <Button fx:id="btnupdateOrder" onAction="#btnupdateOrder"
                                    mnemonicParsing="false" styleClass="btn-thirdty"
                                    prefHeight="40.0" prefWidth="106.0" text="Ubah">
                                <graphic>
                                    <FontIcon iconColor="#473a40" iconLiteral="fas-edit" iconSize="16" />
                                </graphic>
                            </Button>
                            <Button fx:id="btndeleteOrder" onAction="#btndeleteOrder"
                                    mnemonicParsing="false" styleClass="btn-secondary" text="Hapus">
                                <graphic>
                                    <FontIcon iconColor="#ba1a1a" iconLiteral="fas-trash" iconSize="16" />
                                </graphic>
                            </Button>
                            <Button fx:id="btnresetOrder" onAction="#btnresetOrder"
                                    mnemonicParsing="false" styleClass="btn-thirdty" text="Reset">
                                <graphic>
                                    <FontIcon iconColor="#473a40" iconLiteral="fas-undo" iconSize="16" />
                                </graphic>
                            </Button>
                        </children>
                    </HBox>

                    <VBox layoutX="10.0" layoutY="507.0" prefHeight="96.0" prefWidth="420.0" spacing="7.0">
                        <padding><Insets left="10.0" right="10.0" /></padding>
                        <children>
                            <Label styleClass="field-label" text="Jenis Layanan" />
                            <ComboBox fx:id="cmbjlOrder" prefHeight="26.0" prefWidth="408.0"
                                      promptText="Pilih Jenis Layanan" styleClass="input-field" />
                        </children>
                    </VBox>

                    <HBox layoutX="25.0" layoutY="603.0" spacing="50.0">
                        <children>
                            <VBox prefWidth="170.0" spacing="7.0">
                                <Label styleClass="field-label" text="Jumlah" />
                                <Spinner fx:id="spnJumlahItem" editable="true"
                                         prefHeight="42.0" prefWidth="170.0" styleClass="input-field" />
                            </VBox>
                            <VBox prefWidth="170.0" spacing="7.0">
                                <Label styleClass="field-label" text="Tarif" />
                                <TextField fx:id="txttarifItem" editable="false"
                                           prefHeight="42.0" prefWidth="170.0" styleClass="input-field" />
                            </VBox>
                        </children>
                    </HBox>

                    <Button fx:id="btntambahItem" layoutX="9.0" layoutY="687.0"
                            onAction="#btntambahItem" mnemonicParsing="false"
                            prefHeight="38.0" prefWidth="130.0"
                            styleClass="btn-primary" text="+ Tambah Item">
                        <graphic>
                            <FontIcon iconColor="WHITE" iconLiteral="fas-plus" iconSize="14" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnupdateDetail" layoutX="147.0" layoutY="686.0"
                            onAction="#btnupdateDetail" mnemonicParsing="false"
                            prefHeight="40.0" prefWidth="130.0"
                            styleClass="btn-thirdty" text="Ubah Item">
                        <graphic>
                            <FontIcon iconColor="#473a40" iconLiteral="fas-edit" iconSize="14" />
                        </graphic>
                    </Button>
                    <Button fx:id="btndeleteDetail" layoutX="285.0" layoutY="687.0"
                            onAction="#btndeleteDetail" mnemonicParsing="false"
                            prefHeight="38.0" prefWidth="130.0"
                            styleClass="btn-secondary" text="Hapus Item">
                        <graphic>
                            <FontIcon iconColor="#ba1a1a" iconLiteral="fas-trash" iconSize="14" />
                        </graphic>
                    </Button>

                </children>
            </AnchorPane>

            <AnchorPane layoutX="455.0" layoutY="7.0" prefHeight="820.0" prefWidth="920.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <Label layoutX="14.0" layoutY="14.0" styleClass="brand-title"
                           text="Table Data Order" textFill="#5f5157" />
                    <TextField fx:id="txtcariOrder" layoutX="715.0" layoutY="8.0"
                               promptText="search..." styleClass="search-field" />

                    <TableView fx:id="tblOrder" layoutX="9.0" layoutY="59.0"
                               prefHeight="320.0" prefWidth="900.0" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="clmidOrder" prefWidth="74.0" text="ID" />
                            <TableColumn fx:id="clmclidOrder" prefWidth="155.0" text="Client ID" />
                            <TableColumn fx:id="clmkridOrder" prefWidth="113.0" text="Karyawan ID" />
                            <TableColumn fx:id="clmtglOrder" prefWidth="146.0" text="Tgl Order" />
                            <TableColumn fx:id="clmbwOrder" prefWidth="167.0" text="Batas Waktu" />
                            <TableColumn fx:id="clmstatusOrder" prefWidth="127.0" text="Status" />
                            <TableColumn fx:id="clmketOrder" prefWidth="120.0" text="Keterangan" />
                        </columns>
                    </TableView>

                    <Separator layoutX="11.0" layoutY="397.0" prefHeight="11.0"
                               prefWidth="900.0" styleClass="custom-separator-kry" />

                    <Label layoutX="14.0" layoutY="432.0" styleClass="brand-title"
                           text="Table Data Detail Order" textFill="#5f5157" />
                    <TextField fx:id="txtcariDetailOrder" layoutX="718.0" layoutY="426.0"
                               promptText="search..." styleClass="search-field" />

                    <TableView fx:id="tblDetailOrder" layoutX="9.0" layoutY="477.0"
                               prefHeight="335.0" prefWidth="900.0" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="clmidItem" prefWidth="111.0" text="ID" />
                            <TableColumn fx:id="clmnamaItem" prefWidth="150.0" text="Order ID" />
                            <TableColumn fx:id="clmlynidItem" prefWidth="176.0" text="Layanan ID" />
                            <TableColumn fx:id="clmjmlhItem" prefWidth="150.0" text="Jumlah" />
                            <TableColumn fx:id="clmtarifItem" prefWidth="150.0" text="Tarif" />
                            <TableColumn fx:id="clmsubtotItem" prefWidth="163.0" text="Subtotal" />
                        </columns>
                    </TableView>

                </children>
            </AnchorPane>

        </children>
    </AnchorPane>
</AnchorPane>