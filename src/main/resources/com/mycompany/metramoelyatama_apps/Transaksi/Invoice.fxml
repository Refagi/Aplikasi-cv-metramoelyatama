                            <TableColumn fx:id="clminvoiceidByr" prefWidth="108.0" text="Invoice ID" />
                            <TableColumn fx:id="clmtglByr" prefWidth="190.0" text="Tgl Bayar" />
                            <TableColumn fx:id="clmjmlhByr" prefWidth="211.0" text="Jumlah Bayar" />
                            <TableColumn fx:id="clmmetodeByr" prefWidth="171.0" text="Metode Bayar" />
