                                    <FontIcon iconColor="#473a40" iconLiteral="fas-edit" iconSize="16" text="" />
                                </graphic>
                            </Button>
                            <Button fx:id="btndeleteInvoice" layoutX="92.0" layoutY="10.0" mnemonicParsing="false" onAction="#btndeleteInvoice" styleClass="btn-secondary" text="Hapus">
