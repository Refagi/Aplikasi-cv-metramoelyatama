<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane stylesheets="@../css/Dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.laporan.LaporanInvoiceController">

    <AnchorPane fx:id="masterLaporanInvoice" prefHeight="844.0" prefWidth="1199.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>

            <Label layoutX="14.0" prefHeight="29.0" prefWidth="200.0" styleClass="user-title" text="Laporan Invoice" textFill="#5f5157" />
            <Label layoutX="14.0" layoutY="29.0" prefHeight="29.0" prefWidth="280.0" styleClass="user-subtitle" text="Cetak Riwayat Tagihan &amp; Pembayaran" textFill="#5f5157" />

            <AnchorPane layoutX="14.0" layoutY="58.0" prefHeight="100.0" prefWidth="1170.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="30.0" spacing="20.0">
                        <children>
                            <DatePicker fx:id="txtdariInvoice" prefHeight="42.0" prefWidth="160.0" promptText="Tgl Mulai" styleClass="date-picker-field" />
                            <DatePicker fx:id="txtsampaiInvoice" prefHeight="42.0" prefWidth="160.0" promptText="Tgl Selesai" styleClass="date-picker-field" />
                            <ComboBox fx:id="cmbstatusFilterInvoice" prefHeight="42.0" prefWidth="180.0" promptText="Semua Status" styleClass="input-field" />
                            <Button fx:id="btntampilkanInvoice" onAction="#btntampilkanInvoice" prefHeight="42.0" prefWidth="140.0" styleClass="btn-primary" text="Tampilkan">
                                <graphic>
                                    <FontIcon iconColor="WHITE" iconLiteral="fas-search" iconSize="14" />
                                </graphic>
                            </Button>
                            <Button fx:id="btnexportInvoice" onAction="#btnexportInvoice" prefHeight="42.0" prefWidth="160.0" styleClass="btn-thirdty" text="Export PDF">
                                <graphic>
                                    <FontIcon iconColor="#473a40" iconLiteral="fas-file-pdf" iconSize="14" />
                                </graphic>
                            </Button>
                        </children>
                    </HBox>
                </children>
            </AnchorPane>

            <AnchorPane layoutX="14.0" layoutY="168.0" prefHeight="70.0" prefWidth="1170.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <HBox layoutX="20.0" layoutY="20.0" spacing="50.0">
                        <children>
                            <Label fx:id="lblTotalInvoice" styleClass="result-card-top" text="Total Invoice: 0" textFill="#5f5157" />
                            <Label fx:id="lblTotalTagihan" styleClass="result-card-top" text="Total Tagihan: Rp 0" textFill="#5f5157" />
                            <Label fx:id="lblTotalTerbayar" styleClass="result-card-top" text="Sudah Dibayar: Rp 0" textFill="#5f5157" />
                            <Label fx:id="lblTotalSisa" styleClass="result-card-top" text="Sisa Tagihan: Rp 0" textFill="#5f5157" />
                        </children>
                    </HBox>
                </children>
            </AnchorPane>

            <AnchorPane layoutX="14.0" layoutY="248.0" prefHeight="580.0" prefWidth="1170.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <Label layoutX="14.0" layoutY="14.0" styleClass="brand-title" text="Preview Data" textFill="#5f5157" />

                    <TableView fx:id="tblLaporanInvoice" layoutX="9.0" layoutY="50.0" prefHeight="520.0" prefWidth="1150.0" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="clmnoInvoice" prefWidth="50.0" text="No" />
                            <TableColumn fx:id="clmclientInvoice" prefWidth="190.0" text="Client" />
                            <TableColumn fx:id="clmtglInvoice" prefWidth="137.0" text="Tgl Invoice" />
                            <TableColumn fx:id="clmtotalInvoice" prefWidth="199.0" text="Total Tagihan" />
                            <TableColumn fx:id="clmdibayarInvoice" prefWidth="214.0" text="Sudah Dibayar" />
                            <TableColumn fx:id="clmsisaInvoice" prefWidth="194.0" text="Sisa Tagihan" />
                            <TableColumn fx:id="clmstatusInvoice" prefWidth="164.0" text="Status" />
                        </columns>
                    </TableView>
                </children>
            </AnchorPane>

        </children>
    </AnchorPane>
</AnchorPane>
