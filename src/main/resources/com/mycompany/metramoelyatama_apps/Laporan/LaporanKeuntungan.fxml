<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane stylesheets="@../css/Dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LaporanKeuntunganController">

    <AnchorPane fx:id="masterLaporanKeuntungan" prefHeight="844.0" prefWidth="1199.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>

            <Label layoutX="14.0" prefHeight="29.0" prefWidth="220.0" styleClass="user-title" text="Laporan Keuntungan" textFill="#5f5157" />
            <Label layoutX="14.0" layoutY="29.0" prefHeight="29.0" prefWidth="320.0" styleClass="user-subtitle" text="Ringkasan Pemasukan vs Pengeluaran" textFill="#5f5157" />

            <!-- ─── Panel Filter ─── -->
            <AnchorPane layoutX="14.0" layoutY="58.0" prefHeight="100.0" prefWidth="1170.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="30.0" spacing="20.0">
                        <children>
                            <DatePicker fx:id="txtdariKeuntungan" prefHeight="42.0" prefWidth="160.0" promptText="Tgl Mulai" styleClass="date-picker-field" />
                            <DatePicker fx:id="txtsampaiKeuntungan" prefHeight="42.0" prefWidth="160.0" promptText="Tgl Selesai" styleClass="date-picker-field" />
                            <Button fx:id="btntampilkanKeuntungan" onAction="#btntampilkanKeuntungan" prefHeight="42.0" prefWidth="140.0" styleClass="btn-primary" text="Tampilkan">
                                <graphic>
                                    <FontIcon iconColor="WHITE" iconLiteral="fas-search" iconSize="14" />
                                </graphic>
                            </Button>
                            <Button fx:id="btnexportKeuntungan" onAction="#btnexportKeuntungan" prefHeight="42.0" prefWidth="160.0" styleClass="btn-thirdty" text="Export PDF">
                                <graphic>
                                    <FontIcon iconColor="#473a40" iconLiteral="fas-file-pdf" iconSize="14" />
                                </graphic>
                            </Button>
                        </children>
                    </HBox>
                </children>
            </AnchorPane>

            <!-- ─── Panel Ringkasan Besar ─── -->
            <AnchorPane layoutX="14.0" layoutY="168.0" prefHeight="90.0" prefWidth="1170.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <HBox layoutX="20.0" layoutY="25.0" spacing="70.0">
                        <children>
                            <Label fx:id="lblTotalPemasukan" styleClass="result-card-top" text="Total Pemasukan: Rp 0" textFill="#1b7d3c" />
                            <Label fx:id="lblTotalPengeluaran" styleClass="result-card-top" text="Total Pengeluaran: Rp 0" textFill="#ba1a1a" />
                            <Label fx:id="lblTotalKeuntungan" styleClass="result-card-top" text="Keuntungan: Rp 0" textFill="#5f5157" />
                        </children>
                    </HBox>
                </children>
            </AnchorPane>

            <!-- ─── Panel Tabel Breakdown Per Bulan ─── -->
            <AnchorPane layoutX="14.0" layoutY="278.0" prefHeight="550.0" prefWidth="1170.0">
                <styleClass>
                    <String fx:value="bg-second" />
                    <String fx:value="bg-shadow" />
                </styleClass>
                <children>
                    <Label layoutX="14.0" layoutY="14.0" styleClass="brand-title" text="Rincian Per Bulan" textFill="#5f5157" />

                    <TableView fx:id="tblLaporanKeuntungan" layoutX="9.0" layoutY="50.0" prefHeight="490.0" prefWidth="1150.0" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="clmbulanKeuntungan" prefWidth="220.0" text="Bulan" />
                            <TableColumn fx:id="clmpemasukanKeuntungan" prefWidth="280.0" text="Pemasukan" />
                            <TableColumn fx:id="clmpengeluaranKeuntungan" prefWidth="352.0" text="Pengeluaran" />
                            <TableColumn fx:id="clmkeuntunganKeuntungan" prefWidth="296.0" text="Keuntungan" />
                        </columns>
                    </TableView>
                </children>
            </AnchorPane>

        </children>
    </AnchorPane>
</AnchorPane>
